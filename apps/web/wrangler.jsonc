// AxeAI account + remote-access dashboard, TanStack Start on Workers.
//
// Top level = upstream staging; env.production = AxeAI production.
// The @cloudflare/vite-plugin resolves the environment at BUILD time via
// CLOUDFLARE_ENV (not `wrangler deploy --env`): the build writes the resolved
// config to dist/server/wrangler.json and a plain `wrangler deploy` follows
// the .wrangler/deploy/config.json redirect to it.
//
// Deploy staging: pnpm --filter @bb/web build && pnpm --filter @bb/web exec wrangler deploy
// Deploy prod:    CLOUDFLARE_ENV=production pnpm --filter @bb/web build
//                 && pnpm --filter @bb/web exec wrangler deploy
// Secrets (per worker): wrangler secret put [--name bb-web] BETTER_AUTH_SECRET /
//   LANDING_POSTHOG_KEY / RESEND_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-web-staging",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "BASE_DOMAIN": "vibecodethis.site",
    "APP_URL": "https://vibecodethis.site",
    // Resend audience that /api/subscribe adds emails to ("bb users").
    // Not a secret — only the API key is.
    "RESEND_AUDIENCE_ID": "299db4ee-f3db-476d-9847-0bf4344d9c44",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-connect-staging",
      "database_id": "1aaa5562-457d-43a7-b11f-18b4f19bd62c",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL_DO",
        "class_name": "TunnelDO",
        "script_name": "bb-connect-staging",
      },
    ],
  },
  // BB Official plugin marketplace. The registry repo (get-bb/marketplace)
  // uploads marketplace.json + icons here; /marketplace/v1/* serves them.
  // The route answers 404 until the bucket exists, so this binding can land
  // before the bucket is provisioned.
  "r2_buckets": [
    {
      "binding": "MARKETPLACE",
      "bucket_name": "bb-marketplace-staging",
    },
  ],
  "routes": [{ "pattern": "vibecodethis.site", "custom_domain": true }],
  "env": {
    // Production: app.axeai.com is the user-facing dashboard and
    // remote.axeai.com is the pairing API apex. Per-Mac traffic is handled by
    // axeai-connect at <handle>.remote.axeai.com.
    "production": {
      "name": "axeai-web",
      "workers_dev": false,
      "observability": { "enabled": true },
      // Override the inherited staging custom domain; prod domains attach at
      // cutover. Never leave this to inheritance — a prod deploy would steal
      // vibecodethis.site from bb-web-staging.
      "routes": [
        { "pattern": "app.axeai.com/*", "zone_name": "axeai.com" },
        { "pattern": "remote.axeai.com", "custom_domain": true }
      ],
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
        ],
      },
      "vars": {
        "BASE_DOMAIN": "remote.axeai.com",
        "APP_URL": "https://app.axeai.com",
        "AXEAI_AUTH_ISSUER": "https://axeai.com/api/auth",
        "AXEAI_AUTH_CLIENT_ID": "axeai-remote-web",
        "RESEND_AUDIENCE_ID": "299db4ee-f3db-476d-9847-0bf4344d9c44",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "axeai-connect-prod",
          "database_id": "3dc5b12b-a004-4e12-9f5d-621b5e50493c",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "TUNNEL_DO",
            "class_name": "TunnelDO",
            "script_name": "axeai-connect",
          },
        ],
      },
    },
  },
}
